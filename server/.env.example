PORT=8000
HOST=0.0.0.0
API_URL="http://localhost:8000"

# Comma-separated list of origins allowed for CORS and the WebSocket handshake.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Seed script behavior (see src/seed/seed.ts)
BROADCAST="1"
DELAY_MS="250"
MATCH_COUNT="0"

# PostgreSQL connection string (Neon or any Postgres instance)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Account the seed script signs in (or signs up) as, to call protected write routes
SEED_EMAIL=seed@example.com
SEED_PASSWORD=change-me-please
